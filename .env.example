# 复制为 .env 后在本机填写。.env 已被 Git 忽略——不要提交、截图或分享真实密钥。

# ── 大模型（游戏的核心：静的台词、决策与工具调用都来自它） ──
# 任何 OpenAI 兼容的 chat/completions 接口都可以。LLM_* 是通用写法；原有的 DEEPSEEK_* 写法继续有效，
# 两者同时存在时以 LLM_* 为准。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# 其他接口示例（只需改上面三行）：
#   阿里云百炼兼容模式  LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   LLM_MODEL=qwen-plus
#   OpenAI             LLM_BASE_URL=https://api.openai.com/v1                          LLM_MODEL=gpt-4o-mini
#   本机 Ollama / vLLM  LLM_BASE_URL=http://127.0.0.1:11434/v1  LLM_API_KEY=local       LLM_MODEL=qwen2.5:14b

# 可选的兼容性开关（默认值就是原项目的行为）
# LLM_THINKING=disabled      # disabled | enabled | omit —— 接口不认识 thinking 字段时用 omit
# LLM_JSON_MODE=on           # off —— 接口不支持 response_format 时关闭（仍会从回复中提取 JSON）
# LLM_TIMEOUT=30             # 单次请求超时（秒）
# LLM_RETRIES=2              # 失败重试次数（密钥/模型名错误不会重试）
# LLM_SESSION_QUOTA=400      # 每个会话的模型调用上限，用尽后回落到离线兜底
# LLM_EXTRA_BODY={}          # 追加到请求体的 JSON，例如 {"top_p":0.9}

# 原有写法（继续有效；不要和上面的 LLM_* 同时填写）
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash

# ── 阿里云情感语音（可选；未配置时只显示字幕，并播放合成的提示音） ──
DASHSCOPE_API_KEY=
# 使用自己工作空间的地址：wss://<workspace>.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference
DASHSCOPE_TTS_WS_URL=
DASHSCOPE_TTS_MODEL=qwen-audio-3.1-tts-flash
DASHSCOPE_TTS_VOICE=longanhuan_v3.1

# 配置完成后运行一次真实联调自检：
#   python scripts/check_llm.py
